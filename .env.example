# Slack Webhook Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Security (Optional)
# API_KEY=your-secret-api-key-here

# Notion User to Database Mapping (JSON 형식)
# Database ID로 User ID를 역조회할 때 사용됩니다
# 형식: {"Slack_User_ID":"Notion_Database_ID"}
# 주의: 등록되지 않은 Database ID 요청은 거부됩니다 (관리자 문의 메시지 반환)
USER_DATABASE_MAPPING={"USER_ID_1":"database-id-1","USER_ID_2":"database-id-2"}
