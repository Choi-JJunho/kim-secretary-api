# Slack Webhook Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Security (Optional)
# API_KEY=your-secret-api-key-here

# Notion User to Database Mapping (JSON 형식)
# Database ID로 User ID를 역조회할 때 사용됩니다
# 형식: {"Slack_User_ID":"Notion_Database_ID"}
# 예시: {"U0521JJF170":"290b3645-abb5-803f-b2d6-d8577918ac2f","default":"fallback-db-id"}
# 참고: "default" 키는 fallback용이며, 실제 user_id가 우선 반환됩니다
USER_DATABASE_MAPPING={"default":"your-notion-database-id-here"}
